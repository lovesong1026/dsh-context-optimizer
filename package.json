{
  "name": "dsh-context-optimizer",
  "version": "0.1.0",
  "description": "Audit and dynamically optimise DeepSeek Harness context and tool schemas.",
  "author": "lovesong1026",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovesong1026/dsh-context-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/lovesong1026/dsh-context-optimizer/issues"
  },
  "homepage": "https://github.com/lovesong1026/dsh-context-optimizer#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-optimization",
    "token-optimization",
    "progressive-disclosure"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "test": "node --test 'tests/*.test.ts'",
    "test:audit": "node --test tests/audit/analyze.test.ts tests/audit/audit-scope.test.ts tests/audit/locale.test.ts tests/audit/routes.test.ts tests/audit/scan.test.ts tests/audit/tokens.test.ts",
    "test:optimizer": "vitest run tests/optimizer/config.spec.ts tests/optimizer/disclosure.spec.ts tests/optimizer/groups.spec.ts tests/optimizer/matcher.spec.ts",
    "test:integration": "vitest run tests/optimizer/engine.spec.ts && node --test tests/audit/plugin.test.ts tests/audit/bundle.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "./scripts/build.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.15.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=22.19" },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
